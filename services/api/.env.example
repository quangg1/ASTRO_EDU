# Copy → services/api/.env (local). Tên biến: ../../shared/envNames.js

PORT=3002
MONGODB_URI=
CLIENT_URL=
JWT_SECRET=
INTERNAL_API_SECRET=

# Tùy chọn — URL công khai API (Render set qua API_PUBLIC_URL)
# API_PUBLIC_URL=

# VNPay (bắt buộc nếu dùng thanh toán)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_HOST=
# VNPAY_TEST_MODE=true

# OAuth / Firebase / SMTP / S3 — xem SERVICES.md
