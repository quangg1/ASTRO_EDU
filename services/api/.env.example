# Copy → services/api/.env (local). Tên biến: ../../shared/envNames.js

PORT=3002
MONGODB_URI=
CLIENT_URL=
JWT_SECRET=
INTERNAL_API_SECRET=

# Tùy chọn — URL công khai API (Render set qua API_PUBLIC_URL)
# API_PUBLIC_URL=

# Tỷ giá quy đổi doanh thu báo cáo (USD → VND). Client: NEXT_PUBLIC_USD_TO_VND_RATE
# USD_TO_VND_RATE=25000

# Thanh toán khóa học: checkout nội bộ (demo thẻ, không cổng VNPay).
# Gem voucher: payment/constants/courseVoucherTiers.js

# Email (tùy chọn) — đăng ký, quên MK, hóa đơn, mã lớp, đơn GV
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Cosmo Learn <noreply@example.com>
# SMTP_PORT=587
# SMTP_SECURE=false

# AI (Python services/ai — uvicorn :5005; RAG cần embedding)
AI_SERVICE_URL=http://127.0.0.1:5005
# Chỉ cần khi chạy script rag:reindex-full từ API; RAG runtime gọi qua AI service
EMBEDDING_URL=http://127.0.0.1:5004
# EMBEDDING_API_KEY=  # nếu embedding trên HF Space (public)

# Agent fast path & response cache (P0–P2). Cần EMBEDDING_URL cho semantic cache.
# AGENT_CACHE_ENABLED=1
# AGENT_CACHE_SIM_THRESHOLD=0.88
# AGENT_CACHE_MAX_ENTRIES=500
# AGENT_CACHE_TTL_SEC=259200
# AGENT_FAQ_CACHE_TTL_SEC=604800
# AGENT_EMBED_TIMEOUT_MS=8000

# OAuth / Firebase / S3 — xem SERVICES.md
