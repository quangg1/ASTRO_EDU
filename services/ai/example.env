# Copy to services/ai/.env — không commit file .env thật.

# Thứ tự thử LLM (fallback trái → phải). Mặc định khi có OPENROUTER_API_KEY:
# openrouter,lmstudio,groq
LLM_PROVIDER_ORDER=openrouter,lmstudio,groq

# --- OpenRouter (cloud, có credits) ---
# Một key (legacy):
OPENROUTER_API_KEY=sk-or-v1-...
# Hoặc nhiều key — thử lần lượt khi hết credit / 429 (key trước fail → key sau):
# OPENROUTER_API_KEYS=sk-or-v1-aaa...,sk-or-v1-bbb...,sk-or-v1-ccc...
# Model ghép theo index (thiếu → lặp model cuối hoặc OPENROUTER_MODEL):
# OPENROUTER_MODELS=openrouter/free,anthropic/claude-3-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VLM_MODEL=...        # model vision khi gửi ảnh (1 key)
# OPENROUTER_VLM_MODELS=m1,m2     # vision khi dùng OPENROUTER_API_KEYS
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Galaxies Edu

# --- LM Studio (local, không tốn credit OpenRouter) ---
# Bật Local Server trong LM Studio (OpenAI compatible), load model trước.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct
LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_VLM_MODEL=llava-...   # khi cần vision local

# --- Groq (tùy chọn, sau cùng trong chain) ---
# GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=gsk_aaa...,gsk_bbb...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

EMBEDDING_URL=http://127.0.0.1:5004
# Khi embedding trên Hugging Face Spaces (hoặc host khác có auth):
# EMBEDDING_URL=https://your-user-galaxies-embedding.hf.space
# EMBEDDING_API_KEY=shared-secret-with-space
# Timeout embed (giây) — tăng khi Space cold start (mặc định 120)
# EMBED_TIMEOUT_SEC=120
# Tuỳ chọn — nếu set, API append/rebuild phải gửi Bearer cùng token
# KNOWLEDGE_ADMIN_TOKEN=your-secret-token
USE_RAG=1
USE_AGENT_TOOLS=1
