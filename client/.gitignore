# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large media – lưu trên cloud, không commit (xem docs/MEDIA_CLOUD.md)
/public/course-media/
/public/models/
/public/textures/
/public/images/
/public/videos/
/public/live2d/

# Sky planetarium (~50MB+) — CDN prefix /sky/; giữ README + index.json trong repo
/public/sky/**/*.webp
/public/sky/**/*.png
/public/sky/**/*.jpg
/public/sky/**/*.mp4
/public/sky/data/hygdata_v41.csv
/public/sky/data/hip-bright.json
/public/sky/bahia_de_cadiz/
/public/sky/balinese_sky_culture/
/public/sky/descr_pics/
/public/sky/_stellarium-ref/
!/public/sky/README.md
!/public/sky/western_sky_culture/
/public/sky/western_sky_culture/*
!/public/sky/western_sky_culture/index.json
