{
  "name": "earth-history-simulator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:poll": "cross-env WATCHPACK_POLLING=1 next dev",
    "prebuild": "npm run check:guards",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:guards": "npm run check:boundaries && npm run check:earth-ssot && npm run check:app-public && npm run check:store-imports && npm run check:components-public",
    "check:store-imports": "node scripts/check-store-imports.mjs",
    "check:components-public": "node scripts/check-components-public.mjs",
    "check:app-public": "node scripts/check-app-public-imports.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:boundaries:report": "node scripts/check-import-boundaries.mjs --report",
    "check:earth-ssot": "node scripts/check-earth-history-ssot.mjs",
    "hybrid:web:build": "next build",
    "hybrid:sync": "npx cap sync",
    "hybrid:copy": "npx cap copy",
    "hybrid:open:android": "npx cap open android",
    "hybrid:open:ios": "npx cap open ios",
    "hybrid:run:android": "npx cap run android -l --external",
    "hybrid:run:ios": "npx cap run ios -l --external"
  },
  "dependencies": {
    "@galaxies/contracts": "file:../packages/contracts",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.2",
    "@floating-ui/dom": "^1.7.6",
    "@react-three/drei": "^9.96.0",
    "@react-three/fiber": "^8.15.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-color": "^3.20.1",
    "@tiptap/extension-highlight": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-text-align": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/three": "^0.160.0",
    "clsx": "^2.1.0",
    "d3-force": "^3.0.0",
    "firebase": "^11.10.0",
    "framer-motion": "^12.36.0",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-force-graph-2d": "^1.25.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "three": "^0.160.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
